{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scan": {
    "TrivyExecutablePath": "trivy",
    "ScanTimeoutMinutes": 15,
    "CloneTimeoutMinutes": 10,
    "DbUpdateTimeoutMinutes": 5,
    "DotnetExecutablePath": "dotnet",
    "RestoreTimeoutMinutes": 10,
    "RestoreTotalTimeoutMinutes": 20,
    "MaxDbAgeDays": 7,
    "PollIntervalSeconds": 5
  }
}
